# Local development and the root Vercel deployment use the same-origin API.
# Leave these unset. An empty VITE_API_URL also uses /api/v1.
# VITE_API_URL=/api/v1
# VITE_SOCKET_URL=

# Only for a separate backend on the SAME SITE, with credentials and exact CORS:
# VITE_API_URL=https://api.your-domain.example/api/v1
# VITE_SOCKET_URL=https://api.your-domain.example
# Unrelated domains need a same-origin API proxy for reliable browser cookies.
