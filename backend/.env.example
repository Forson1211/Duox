PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27018/duo_clash?replicaSet=duo
# Production: set these in the backend host's environment variables.
# NODE_ENV=production
# FRONTEND_ORIGIN=https://duoxgame.vercel.app
# MONGODB_URI=mongodb+srv://USER:ENCODED_PASSWORD@CLUSTER.mongodb.net/duo_clash?retryWrites=true&w=majority
# Optional SMTP password reset delivery.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
# Existing registered account; run npm run admin once, then remove this variable.
ADMIN_BOOTSTRAP_EMAIL=
